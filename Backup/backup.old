import gspread
from google.oauth2.service_account import Credentials
from datetime import datetime
from zoneinfo import ZoneInfo


# ============================================================
# GOOGLE SHEETS
# ============================================================

SCOPES = [
    "https://www.googleapis.com/auth/spreadsheets"
]

CREDS = Credentials.from_service_account_file(
    "credentials.json",
    scopes=SCOPES
)

CLIENT = gspread.authorize(CREDS)

SHEET_ID = "1kd_8lUj2pv3CBCygY5p6FdGjq5mQX9TVq8hHs_mfCrk"

SPREADSHEET = CLIENT.open_by_key(SHEET_ID)

# ใช้ Sheet แรก
SHEET = SPREADSHEET.sheet1


# ============================================================
# DEFAULT DATA
# ============================================================

DEFAULT_STAT = {
    "FUEL_TYPE": "E20",
    "CAR_MODEL": "Mitsubishi Mirage",
    "TANK_CAPACITY": 35.0
}


# ============================================================
# HEADERS
# ============================================================

HEADERS = [
    "วันที่",
    "ประเภทเชื้อเพลิง",
    "รุ่นรถ",
    "เลขไมล์ปัจจุบัน",
    "เลขไมล์ครั้งก่อน",
    "ระยะทาง",
    "จำนวนลิตร",
    "ราคาน้ำมันต่อลิตร",
    "ราคารวม",
    "อัตราสิ้นเปลืองเชื้อเพลิง",
    "ค่าใช้จ่ายต่อกิโลเมตร",
    "จำนวนขีดน้ำมัน",
    "จำนวนลิตรต่อขีด",
    "ระยะทางโดยประมาณ"
]


# ============================================================
# SETUP SHEET
# ============================================================

def setup_sheet() -> None:

    values = SHEET.get_all_values()

    # ถ้า Sheet ว่าง
    if not values:

        SHEET.update(
            "A1:N1",
            [HEADERS]
        )

        print("สร้าง Header เรียบร้อย")

        return

    # ตรวจสอบ Header
    current_headers = values[0]

    if current_headers != HEADERS:

        SHEET.update(
            "A1:N1",
            [HEADERS]
        )

        print("อัปเดต Header เป็นภาษาไทยเรียบร้อย")


# ============================================================
# NUMBER FORMAT
# ============================================================

def setup_number_format() -> None:

    # ไม่แตะ Header
    # ไม่เปลี่ยนสี
    # ไม่เปลี่ยน Bold

    # เลขไมล์ปัจจุบัน
    SHEET.format(
        "D2:D1000",
        {
            "numberFormat": {
                "type": "NUMBER",
                "pattern": "0"
            }
        }
    )

    # เลขไมล์ครั้งก่อน
    SHEET.format(
        "E2:E1000",
        {
            "numberFormat": {
                "type": "NUMBER",
                "pattern": "0"
            }
        }
    )

    # ระยะทาง
    SHEET.format(
        "F2:F1000",
        {
            "numberFormat": {
                "type": "NUMBER",
                "pattern": "0"
            }
        }
    )

    # จำนวนลิตร
    SHEET.format(
        "G2:G1000",
        {
            "numberFormat": {
                "type": "NUMBER",
                "pattern": "0.00"
            }
        }
    )

    # ราคาน้ำมันต่อลิตร
    SHEET.format(
        "H2:H1000",
        {
            "numberFormat": {
                "type": "NUMBER",
                "pattern": "0.00"
            }
        }
    )

    # ราคารวม
    SHEET.format(
        "I2:I1000",
        {
            "numberFormat": {
                "type": "NUMBER",
                "pattern": "0.00"
            }
        }
    )

    # อัตราสิ้นเปลือง
    SHEET.format(
        "J2:J1000",
        {
            "numberFormat": {
                "type": "NUMBER",
                "pattern": "0.00"
            }
        }
    )

    # ค่าใช้จ่ายต่อกิโลเมตร
    SHEET.format(
        "K2:K1000",
        {
            "numberFormat": {
                "type": "NUMBER",
                "pattern": "0.00"
            }
        }
    )

    # จำนวนขีดน้ำมัน
    SHEET.format(
        "L2:L1000",
        {
            "numberFormat": {
                "type": "NUMBER",
                "pattern": "0"
            }
        }
    )

    # จำนวนลิตรต่อขีด
    SHEET.format(
        "M2:M1000",
        {
            "numberFormat": {
                "type": "NUMBER",
                "pattern": "0.00"
            }
        }
    )

    # ระยะทางโดยประมาณ
    SHEET.format(
        "N2:N1000",
        {
            "numberFormat": {
                "type": "NUMBER",
                "pattern": "0.00"
            }
        }
    )


# ============================================================
# GET PREVIOUS ODOMETER
# ============================================================

def get_previous_odometer() -> int | None:

    """
    อ่านเลขไมล์ปัจจุบันจาก Column D โดยตรง

    Column D = เลขไมล์ปัจจุบัน

    ไม่ใช้ get_all_records()
    """

    odometer_values = SHEET.col_values(4)

    # มีแค่ Header
    if len(odometer_values) <= 1:
        return None

    # อ่านจากล่างขึ้นบน
    for value in reversed(odometer_values[1:]):

        value = value.strip()

        if value == "":
            continue

        try:

            return int(float(value))

        except ValueError:

            continue

    return None


# ============================================================
# SAVE DATA
# ============================================================

def save_fuel_data(
    fuel_data: dict
) -> None:

    row = [
        fuel_data["Date"],
        fuel_data["FuelType"],
        fuel_data["CarModel"],
        fuel_data["CurrentOdometer"],
        fuel_data["PreviousOdometer"],
        fuel_data["Distance"],
        fuel_data["Liters"],
        fuel_data["ActualPrice"],
        fuel_data["TotalPrice"],
        fuel_data["FuelEfficiency"],
        fuel_data["CostPerKm"],
        fuel_data["FuelBar"],
        fuel_data["LitersPerBar"],
        fuel_data["EstimatedDistance"]
    ]

    # เพิ่มลงแถวถัดไป
    SHEET.append_row(
        row,
        value_input_option="USER_ENTERED"
    )

    print("บันทึกข้อมูลลง Google Sheets เรียบร้อย")


# ============================================================
# INPUT INTEGER
# ============================================================

def get_integer(
    message: str
) -> int:

    while True:

        try:

            value = int(
                input(message)
            )

            if value < 0:

                print(
                    "กรุณาใส่ค่ามากกว่าหรือเท่ากับ 0"
                )

                continue

            return value

        except ValueError:

            print(
                "กรุณาใส่เป็นตัวเลขจำนวนเต็ม"
            )


# ============================================================
# INPUT FLOAT
# ============================================================

def get_float(
    message: str
) -> float:

    while True:

        try:

            value = float(
                input(message)
            )

            if value <= 0:

                print(
                    "กรุณาใส่ค่ามากกว่า 0"
                )

                continue

            return value

        except ValueError:

            print(
                "กรุณาใส่เป็นตัวเลข"
            )


# ============================================================
# MAIN
# ============================================================

def main() -> None:

    print()
    print("========================================")
    print("       FUEL CALCULATION SYSTEM")
    print("========================================")
    print()


    # ========================================================
    # Setup Google Sheet
    # ========================================================

    setup_sheet()

    setup_number_format()


    # ========================================================
    # Previous Odometer
    # ========================================================

    previous_odometer = get_previous_odometer()


    if previous_odometer is None:

        print(
            "ยังไม่มีข้อมูลเลขไมล์ครั้งก่อน"
        )

        previous_odometer = get_integer(
            "เลขไมล์เริ่มต้น: "
        )

    else:

        print(
            f"เลขไมล์ครั้งก่อน: "
            f"{previous_odometer}"
        )


    print()


    # ========================================================
    # Input
    # ========================================================

    current_odometer = get_integer(
        "เลขไมล์ปัจจุบัน: "
    )

    liters = get_float(
        "เติมน้ำมันกี่ลิตร: "
    )

    total_price = get_float(
        "เติมน้ำมันกี่บาท: "
    )

    fuel_bar = get_integer(
        "เกจน้ำมันเพิ่มกี่ขีด: "
    )


    # ========================================================
    # Validate Odometer
    # ========================================================

    if current_odometer < previous_odometer:

        print()
        print("ERROR")
        print(
            "เลขไมล์ปัจจุบันน้อยกว่าเลขไมล์ครั้งก่อน"
        )

        print(
            f"เลขไมล์ครั้งก่อน: {previous_odometer}"
        )

        print(
            f"เลขไมล์ปัจจุบัน: {current_odometer}"
        )

        return


    # ========================================================
    # DATE
    # ========================================================

    current_datetime = datetime.now(
        ZoneInfo("Asia/Bangkok")
    )

    date = current_datetime.strftime(
        "%Y-%m-%d %H:%M:%S"
    )


    # ========================================================
    # CALCULATIONS
    # ========================================================

    # --------------------------------------------------------
    # Fuel Price
    # --------------------------------------------------------

    actual_price_value = (
        total_price / liters
    )


    # --------------------------------------------------------
    # Distance
    #
    # สำคัญ:
    # คำนวณตรง ๆ ไม่ผ่าน function
    # --------------------------------------------------------

    distance_value = (
        current_odometer
        - previous_odometer
    )


    # --------------------------------------------------------
    # Fuel Efficiency
    # --------------------------------------------------------

    if distance_value > 0:

        fuel_efficiency_value = (
            distance_value / liters
        )

    else:

        fuel_efficiency_value = 0.0


    # --------------------------------------------------------
    # Cost Per Km
    # --------------------------------------------------------

    if distance_value > 0:

        cost_per_km_value = (
            total_price / distance_value
        )

    else:

        cost_per_km_value = 0.0


    # --------------------------------------------------------
    # Liters Per Bar
    # --------------------------------------------------------

    if fuel_bar > 0:

        liters_per_bar_value = (
            liters / fuel_bar
        )

    else:

        liters_per_bar_value = 0.0


    # --------------------------------------------------------
    # Estimated Distance
    # --------------------------------------------------------

    estimated_distance_value = (
        liters
        * fuel_efficiency_value
    )


    # ========================================================
    # CREATE DATA
    # ========================================================

    fuel_data = {

        "Date": date,

        "FuelType": DEFAULT_STAT[
            "FUEL_TYPE"
        ],

        "CarModel": DEFAULT_STAT[
            "CAR_MODEL"
        ],

        "CurrentOdometer": current_odometer,

        "PreviousOdometer": previous_odometer,

        "Distance": distance_value,

        "Liters": liters,

        "ActualPrice": actual_price_value,

        "TotalPrice": total_price,

        "FuelEfficiency": fuel_efficiency_value,

        "CostPerKm": cost_per_km_value,

        "FuelBar": fuel_bar,

        "LitersPerBar": liters_per_bar_value,

        "EstimatedDistance": estimated_distance_value
    }


    # ========================================================
    # DEBUG
    # ========================================================

    print()
    print("========== DEBUG ==========")

    print(
        f"Previous Odometer : "
        f"{previous_odometer}"
    )

    print(
        f"Current Odometer  : "
        f"{current_odometer}"
    )

    print(
        f"Distance          : "
        f"{distance_value}"
    )

    print(
        f"Calculation       : "
        f"{current_odometer} - "
        f"{previous_odometer} = "
        f"{distance_value}"
    )

    print("============================")
    print()


    # ========================================================
    # SAVE
    # ========================================================

    save_fuel_data(
        fuel_data
    )


    # ========================================================
    # RESULT
    # ========================================================

    print()
    print("========================================")
    print("              ผลการคำนวณ")
    print("========================================")

    print(
        f"วันที่: "
        f"{date}"
    )

    print(
        f"ประเภทเชื้อเพลิง: "
        f"{fuel_data['FuelType']}"
    )

    print(
        f"รุ่นรถ: "
        f"{fuel_data['CarModel']}"
    )

    print(
        f"เลขไมล์ปัจจุบัน: "
        f"{current_odometer}"
    )

    print(
        f"เลขไมล์ครั้งก่อน: "
        f"{previous_odometer}"
    )

    print(
        f"ระยะทาง: "
        f"{distance_value} km"
    )

    print(
        f"จำนวนลิตร: "
        f"{liters:.2f} L"
    )

    print(
        f"ราคาน้ำมันต่อลิตร: "
        f"{actual_price_value:.2f} บาท/L"
    )

    print(
        f"ราคารวม: "
        f"{total_price:.2f} บาท"
    )

    print(
        f"อัตราสิ้นเปลืองเชื้อเพลิง: "
        f"{fuel_efficiency_value:.2f} km/L"
    )

    print(
        f"ค่าใช้จ่ายต่อกิโลเมตร: "
        f"{cost_per_km_value:.2f} บาท/km"
    )

    print(
        f"จำนวนขีดน้ำมัน: "
        f"{fuel_bar}"
    )

    print(
        f"จำนวนลิตรต่อขีด: "
        f"{liters_per_bar_value:.2f} L/bar"
    )

    print(
        f"ระยะทางโดยประมาณ: "
        f"{estimated_distance_value:.2f} km"
    )

    print("========================================")
    print("บันทึกข้อมูลสำเร็จ")
    print("========================================")


# ============================================================
# RUN
# ============================================================

if __name__ == "__main__":
    main()